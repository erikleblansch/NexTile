# Runtime verification only. Never included in the extension archive.
ARG FEDORA_IMAGE=fedora:45@sha256:a7d72ba2745b100a3351087472e5ee7b2450af7cf331e7673007e3817612839c
FROM ${FEDORA_IMAGE}
RUN dnf -y install gnome-shell gnome-terminal gjs python3-gobject gtk3 \
    dbus-daemon mesa-dri-drivers xorg-x11-server-Xwayland glib2 gettext \
    procps-ng util-linux \
    && dnf clean all \
    && useradd -m -u 1000 nextile \
    && rmdir /run/systemd/seats
ENV HOME=/home/nextile LANG=C.UTF-8 LIBGL_ALWAYS_SOFTWARE=1
COPY tests/container-entrypoint.sh /usr/local/bin/nextile-runtime
ENTRYPOINT ["bash", "/usr/local/bin/nextile-runtime"]
