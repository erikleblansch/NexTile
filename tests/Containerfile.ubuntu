# GNOME 46 acceptance only; never shipped in the extension archive.
ARG UBUNTU_IMAGE=ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
FROM ${UBUNTU_IMAGE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    gnome-shell gnome-terminal gjs python3-gi gir1.2-gtk-3.0 dbus-daemon \
    libgl1-mesa-dri libglx-mesa0 libegl-mesa0 xwayland libglib2.0-bin gettext \
    procps util-linux fonts-dejavu-core librsvg2-common \
    && rm -rf /var/lib/apt/lists/* \
    && userdel ubuntu && useradd -m -u 1000 nextile
ENV HOME=/home/nextile LANG=C.UTF-8 LIBGL_ALWAYS_SOFTWARE=1
COPY tests/container-entrypoint.sh /usr/local/bin/nextile-runtime
ENTRYPOINT ["bash", "/usr/local/bin/nextile-runtime"]
